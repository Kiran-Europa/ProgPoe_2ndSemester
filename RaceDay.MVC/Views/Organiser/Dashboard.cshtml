@model IEnumerable<RaceDay.MVC.Controllers.EventDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-primary">+ Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-body">
            <h4 class="card-title mb-3">Managed Events</h4>
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event ID</th>
                        <th>Event Name</th>
                        <th>Class / Category</th>
                        <th>Track ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.EventID</td>
                                <td>@ev.EventName</td>
                                <td><span class="badge bg-secondary">@ev.EventClass</span></td>
                                <td>@ev.TrackID</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-info text-white">View Enrolments</a>
                                    <a href="#" class="btn btn-sm btn-warning">Edit</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No events found. Create one to get started!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>