@model IEnumerable<RaceDay.MVC.Controllers.ParticipantResultDto>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">
    <h2>My Race History & Results</h2>
    <p class="text-muted">Review your past performances, vehicle stats, and recorded wins across all completed events.</p>

    <div class="card shadow mt-3">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Participant ID</th>
                        <th>Name</th>
                        <th>Vehicle / Car</th>
                        <th>Total Wins</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td>@res.PartID</td>
                                <td>@res.Partname</td>
                                <td><span class="badge bg-primary">@res.PartCar</span></td>
                                <td><strong>@res.PartWins</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No race results found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>