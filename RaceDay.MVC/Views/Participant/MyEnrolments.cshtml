@model IEnumerable<RaceDay.MVC.Controllers.TeamEventDto>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Event Enrolments</h2>
    <p class="text-muted">Track your registered events and enrolment statuses.</p>

    <div class="card shadow mt-3">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Event ID</th>
                        <th>Team ID</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EventTeamID</td>
                                <td>@item.EventID</td>
                                <td>@item.TeamID</td>
                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">You have not enrolled in any events yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>